# Copia este archivo a .env y completa los valores.

# Clave secreta para firmar las cookies de sesion. Genera una propia (ej. python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# En local no hace falta tocar esto (usa SQLite por defecto).
# En produccion (Render/Railway) pon aqui la URL de Postgres que te den, ej:
# DATABASE_URL=postgresql+psycopg://usuario:password@host:5432/basededatos
DATABASE_URL=sqlite:///./cumbre_capital.db
